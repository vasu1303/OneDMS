{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onedms.corp/schemas/canonical_invoice.json",
  "title": "CanonicalInvoice",
  "description": "Standardized OEM Canonical Invoice Schema",
  "type": "object",
  "required": [
    "invoice_number",
    "invoice_date",
    "currency",
    "total_amount",
    "line_items"
  ],
  "properties": {
    "invoice_number": {
      "type": "string",
      "description": "Unique invoice identifier"
    },
    "invoice_date": {
      "type": "string",
      "format": "date",
      "description": "ISO date format (YYYY-MM-DD)"
    },
    "buyer_oem_id": {
      "type": ["string", "null"],
      "description": "OEM buyer identifier (e.g. DTNA, MBAG)"
    },
    "currency": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3,
      "description": "ISO 4217 3-letter currency code"
    },
    "subtotal_amount": {
      "type": ["number", "null"],
      "description": "Total before taxes and discounts"
    },
    "tax_amount": {
      "type": ["number", "null"],
      "description": "Total tax amount"
    },
    "total_amount": {
      "type": "number",
      "description": "Grand total payable amount"
    },
    "line_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "line_number",
          "description",
          "quantity",
          "unit_price",
          "line_total"
        ],
        "properties": {
          "line_number": {
            "type": "integer",
            "minimum": 1
          },
          "item_code": {
            "type": ["string", "null"]
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "discount_amount": {
            "type": "number",
            "default": 0.0
          },
          "taxable_amount": {
            "type": ["number", "null"]
          },
          "tax_rate": {
            "type": ["number", "null"]
          },
          "tax_amount": {
            "type": "number",
            "default": 0.0
          },
          "line_total": {
            "type": "number"
          },
          "chassis_number": {
            "type": ["string", "null"]
          }
        }
      }
    }
  }
}
